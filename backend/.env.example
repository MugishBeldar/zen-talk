# ZenTalk Backend Environment Variables

# Application Configuration
NODE_ENV=development
PORT=8000
API_VERSION=v1

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/zentalk_dev
MONGODB_TEST_URI=mongodb://localhost:27017/zentalk_test

# Redis Configuration (for rate limiting and caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Configuration
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ISSUER=zentalk-api
JWT_AUDIENCE=zentalk-client
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Security Configuration
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=your-super-secret-session-key-here
ENCRYPTION_KEY=your-32-character-encryption-key

# Rate Limiting
ENABLE_RATE_LIMITING=true
API_RATE_LIMIT_WINDOW=15
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=5

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Email Configuration (for future features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
CDN_URL=https://cdn.zentalk.com

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
ENABLE_REQUEST_LOGGING=true

# Security Headers
ENABLE_HELMET=true
ENABLE_CORS=true
TRUST_PROXY=false

# Development Configuration
ENABLE_SWAGGER=true
ENABLE_MORGAN_LOGGING=true
ENABLE_DEBUG_ROUTES=true
